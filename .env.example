# Какие переменные нужны проекту. Значения здесь не хранятся - копию этого
# файла назовите .env.local и впишите настоящие; .env.local в git не попадает.

# Ключ JavaScript API Яндекс Карт. Берётся в кабинете разработчика
# https://yandex.ru/maps-api/console и обязательно ограничивается доменами.
#
# Префикс NEXT_PUBLIC_ обязателен: карта рисуется в браузере, значит ключ
# должен попасть в браузер. Он будет виден в исходном коде страницы - это
# нормально для картографического ключа и ровно поэтому список доменов в
# кабинете и защищает нас, а не секретность самого ключа.
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# Токен и файл Figma - только для сверки вёрстки с макетом при разработке.
# Без префикса: остаются на сервере и в браузер не уезжают.
FIGMA_TOKEN=
FIGMA_FILE_URL=

# --- Storyblok ---------------------------------------------------------------
# Пространство: Web Trendsetter. Ни у одной переменной ниже нет префикса
# NEXT_PUBLIC_ - и не должно появиться: контент забирает сервер, в браузер
# уезжает уже готовая страница, а токены остаются здесь.

# Токен чтения. Settings -> Access Tokens, тип Preview.
# Preview, а не Public: этим же токеном мы просим черновики для предпросмотра,
# а опубликованное берётся тем же токеном с version=published. Public умеет
# только второе, и тогда пришлось бы держать два.
STORYBLOK_TOKEN=

# Регион пространства: eu, us, ap или ca. Смотреть в Settings -> General.
# Задаётся явно, потому что от него зависит адрес API, а перепутанный регион
# выглядит как "пространство пустое", а не как ошибка.
STORYBLOK_REGION=eu

# Числовой id пространства, там же в Settings -> General. Нужен командной
# строке, чтобы заливать в него схемы блоков из репозитория.
STORYBLOK_SPACE_ID=

# Личный токен управления. My Account -> Personal access tokens.
# Им правится само пространство - схемы блоков, перенос контента, - поэтому он
# сильнее токена чтения и живёт только на машине разработчика: в Vercel его
# заводить не нужно.
STORYBLOK_PERSONAL_TOKEN=

# Наши собственные секреты, не выданные Storyblok - придумайте любые длинные
# строки. Первый включает режим предпросмотра по ссылке из редактора, второй
# подписывает вебхук, которым Storyblok сообщает нам о публикации. Без них
# любой желающий мог бы читать черновики и сбрасывать кеш сайта.
STORYBLOK_PREVIEW_SECRET=
STORYBLOK_REVALIDATE_SECRET=

# Адрес сайта. Нужен поиску: канонические ссылки, sitemap.xml и картинка для
# соцсетей должны быть абсолютными, с доменом.
#
# Если не задать, берётся домен продакшена от Vercel - этого хватает пока нет
# своего домена. Задавать обязательно, когда домен появится: иначе превью-деплой
# начнёт называть себя каноническим адресом сайта, и поиск пойдёт индексировать
# его вместо настоящего.
#
# С префиксом NEXT_PUBLIC_ - адрес не секрет и нужен в том числе на клиенте.
NEXT_PUBLIC_SITE_URL=
